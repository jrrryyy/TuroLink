PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/turolink
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Transactional email provider SMTP settings. Never put these in client .env files.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google OAuth client type: Web application. This is a client ID, not a secret.
GOOGLE_CLIENT_ID=
