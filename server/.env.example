PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/turolink
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Transactional email provider SMTP settings. Never put these in client .env files.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google OAuth client type: Web application. This is a client ID, not a secret.
GOOGLE_CLIENT_ID=

# Persistent Cloud Storage (Choose Cloudinary OR Vercel Blob for deployed systems)
# Option 1: Cloudinary (Recommended - Free 25GB storage + CDN for images & all documents)
# You can paste your CLOUDINARY_URL directly from your Cloudinary dashboard:
CLOUDINARY_URL=
# Or provide the individual credentials:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: Vercel Blob (If deploying on Vercel with 1-click Blob store)
BLOB_READ_WRITE_TOKEN=
